# Mock API is the default. Set to 0 to talk to the backend (http://localhost:8788 via the Vite proxy;
# set API_PROXY_TARGET when starting Vite to point elsewhere).
VITE_API_MOCK=1
# Override the API base if the backend isn't behind the dev proxy.
# VITE_API_URL=http://localhost:8787/api

# Google login with a Solana embedded wallet. Leave empty to use demo personas instead.
VITE_PRIVY_APP_ID=
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com

# Demo personas against the real API (devnet keypairs, base58 secret or solana-keygen JSON array).
# Local only: app/.env is gitignored. Never put mainnet keys here.
VITE_DEMO_COMPANY_SECRET=
VITE_DEMO_SCOUT_SECRET=
VITE_DEMO_SCOUT2_SECRET=
