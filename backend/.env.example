# --- HTTP ---
PORT=8788
HOST=0.0.0.0
# Comma-separated allowed origins for the app.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info

# --- Database ---
# Postgres from `pnpm db:up` (docker compose, host port 5433). Leave unset to use embedded PGlite in backend/.data.
DATABASE_URL=postgres://scout:scout@localhost:5433/scout

# --- Solana ---
# devnet | localnet (Surfpool on :8899)
CLUSTER=devnet
# Defaults: devnet → https://api.devnet.solana.com, localnet → http://127.0.0.1:8899
# RPC_URL=https://api.devnet.solana.com
# Websocket for the indexer. Defaults to RPC_URL with ws(s)://, or ws://127.0.0.1:8900 on localnet.
# WS_URL=wss://api.devnet.solana.com
# Fee payer / relayer keypair (pays tx fees + rent so users never need SOL).
RELAYER_KEYPAIR=~/.config/solana/id.json
# Written by the setup script in /scripts: programId, usdcMint, config, treasury, treasuryTokenAccount.
# DEPLOYMENT_FILE=../deployments/devnet.json
# Anchor IDL. Defaults: packages/shared/src/idl/scout.json, then target/idl/scout.json.
# IDL_PATH=
# Default holdback for new roles: share of the recruiter payout held until the company confirms the candidate,
# released to the recruiter automatically-by-anyone after the window. Demo: 30% / 120 s.
HOLDBACK_BPS=3000
HOLDBACK_WINDOW_SECONDS=120
# Max RPC requests/second from the backend (public devnet allows ~100 per 10 s per IP, shared with the browser).
RPC_MAX_RPS=8
# off = disable websocket indexer + poller
INDEXER=on
POLL_INTERVAL_MS=15000

# --- AI agent (backend/src/agent) ---
# Without any key the agent runs in offline/heuristic mode, so the demo still works.
# LLM_PROVIDER=openrouter|anthropic|openai|offline (default: first key found, in that order)
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-6-luna   # cheap default; live demo: anthropic/claude-sonnet-5.5
# OPENROUTER_FAST_MODEL=google/gemini-2.5-flash-lite
# Jev (TypeSafe System One via OpenRouter) scores reviews per criterion. Falls back to OPENROUTER_API_KEY.
JEV_API_KEY=
# REVIEW_ENGINE=jev|llm|offline (default: jev when a Jev key exists)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
OPENAI_API_KEY=
# OPENAI_MODEL=

# --- Recall.ai notetaker for screening calls (Stream E) ---
# EU workspace key
RECALL_API_KEY=
RECALL_REGION=eu-central-1
# RECALL_MOCK=1  # simulate the bot with a fixture transcript (demo without a live call)
# RECALL_POLL_MS=5000
# RECALL_MOCK_STEP_MS=3000

# --- Agent runner ---
# The agent's key (role.agent). Defaults to ~/.config/solana/superrecruiter/agent.json
# AGENT_KEYPAIR=
# DEMO_FAST=1   # deterministic agent steps (< 5 s); the LLM only answers chat
# AGENT_STEP_MODE=agent|deterministic
# AGENT_TICK_MS=4000
# AGENT_RUNNER=off
# CLAIM_TIMEOUT_SECONDS=600
