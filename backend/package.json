{
	"name": "@scout/backend",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx watch --env-file-if-exists=.env src/server.ts",
		"start": "tsx --env-file-if-exists=.env src/server.ts",
		"agent": "tsx --env-file-if-exists=.env src/agent/cli.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"seed": "tsx --env-file-if-exists=.env src/scripts/seed.ts"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.131.0",
		"@electric-sql/pglite": "^0.5.8",
		"@fastify/cors": "^11.3.0",
		"@scout/shared": "workspace:*",
		"@solana-program/system": "^0.15.0",
		"@solana-program/token": "^0.17.0",
		"@solana/kit": "^8.4.0",
		"drizzle-orm": "1.0.0-rc.4",
		"fastify": "^5.12.5",
		"fastify-type-provider-zod": "^7.0.0",
		"openai": "^7.27.0",
		"pg": "^8.23.1",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@types/node": "^26.6.4",
		"@types/pg": "^8.23.1",
		"drizzle-kit": "1.0.0-rc.4",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vitest": "^5.0.3"
	}
}
